# @spec docs/BACKLOG.md#RG-018 | docs/DAT.md#deploiement
# Modèle de l'environnement staging. Copié en config/environments/staging.env (ignoré par git) par runStaging.sh,
# qui génère RGPD_GUARD_TOKEN et RGPD_GUARD_HMAC_KEY s'ils sont vides. Ne versionnez jamais le fichier réel.

# Nom de l'environnement. Obligatoire. Valeur : staging.
RGPD_GUARD_ENV=staging
# Jeton d'accès des hooks et du tableau de bord. Obligatoire. Format : 32 caractères aléatoires ou plus.
# Laisser vide : le lanceur le génère au premier démarrage.
RGPD_GUARD_TOKEN=
# Clé des empreintes HMAC du journal d'audit. Obligatoire. Format : 32 caractères aléatoires ou plus.
# Laisser vide : le lanceur la génère. La changer rend les empreintes antérieures incomparables.
RGPD_GUARD_HMAC_KEY=
# Profil par défaut. Facultatif. Valeurs : rapide, equilibre (défaut), max.
RGPD_GUARD_PROFILE=equilibre
# Composants chargés. Facultatif. Exemple : rules,secrets,spacy,laya,gliner.
RGPD_GUARD_ENABLED_DETECTORS=rules,secrets,spacy,laya,gliner
# En-têtes Host acceptés. Obligatoire. Exemple : 127.0.0.1,localhost,engine.
RGPD_GUARD_ALLOWED_HOSTS=127.0.0.1,localhost,engine
# Origines autorisées à modifier (adresse du tableau de bord). Obligatoire. Exemple : http://127.0.0.1:18743.
RGPD_GUARD_CORS_ORIGINS=http://127.0.0.1:18743,http://localhost:18743
# Aperçu masqué des valeurs dans le journal. Facultatif. Valeurs : true, false (recommandé en prod).
RGPD_GUARD_AUDIT_PREVIEW=true
# Rétention du journal en jours. Facultatif. Exemple : 30.
RGPD_GUARD_AUDIT_RETENTION_DAYS=30
# Fils CPU de torch. Facultatif. Exemple : 4.
RGPD_GUARD_TORCH_THREADS=4
