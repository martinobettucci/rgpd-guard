# @spec docs/BACKLOG.md#RG-018 | docs/DAT.md#deploiement
# Environnement de développement : valeurs fixes et NON sensibles, versionnées pour un démarrage autonome.
# Ne jamais réutiliser ces valeurs en staging ou en production.

# Nom de l'environnement (dev, staging, prod).
RGPD_GUARD_ENV=dev
# Jeton des hooks et du tableau de bord (valeur de développement, publique).
RGPD_GUARD_TOKEN=dev-token-rgpd-guard
# Clé des empreintes HMAC du journal (valeur de développement, publique).
RGPD_GUARD_HMAC_KEY=dev-hmac-rgpd-guard
# Profil par défaut : rapide, equilibre ou max.
RGPD_GUARD_PROFILE=equilibre
# Composants chargés au démarrage.
RGPD_GUARD_ENABLED_DETECTORS=rules,secrets,spacy,laya,gliner
# En-têtes Host acceptés (accès direct, tableau de bord Vite, réseau Compose).
RGPD_GUARD_ALLOWED_HOSTS=127.0.0.1,localhost,engine,dashboard
# Origines autorisées à modifier (tableau de bord en local et depuis le conteneur E2E).
RGPD_GUARD_CORS_ORIGINS=http://127.0.0.1:8743,http://localhost:8743,http://dashboard:5173
# Conserver un aperçu masqué des valeurs dans le journal.
RGPD_GUARD_AUDIT_PREVIEW=true
# Rétention du journal en jours.
RGPD_GUARD_AUDIT_RETENTION_DAYS=30
# Fils CPU de torch.
RGPD_GUARD_TORCH_THREADS=4
# Rechargement automatique du code monté.
RGPD_GUARD_RELOAD=true
