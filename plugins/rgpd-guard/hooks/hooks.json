{
  "description": "RGPD Guard : chaque événement est relayé au moteur local, qui décide.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-hook.sh",
              "session-start",
              "5"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-hook.sh",
              "user-prompt-submit",
              "25"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-hook.sh",
              "pre-tool-use",
              "10"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-hook.sh",
              "post-tool-use",
              "55"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-hook.sh",
              "post-tool-use-failure",
              "25"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-hook.sh",
              "post-tool-batch",
              "55"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-hook.sh",
              "subagent-start",
              "5"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}